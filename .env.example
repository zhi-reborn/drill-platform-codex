# =============================================================================
# 高可用多节点部署环境变量
# 使用方式：cp .env.example .env，填写真实值后 docker compose -f docker-compose.ha.yml up -d
# =============================================================================

# ---------- 外部 MySQL HA 连接（由你保证高可用，backend 仅连一个入口地址）----------
# 例：ProxySQL / VIP / RDS 域名 / MGR 单点读写节点
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=drill
DATABASE_PASSWORD=
DATABASE_NAME=drill_platform

# ---------- 外部 Redis 集群连接（集群模式，多节点逗号分隔）----------
# 例：node1:6379,node2:6379,node3:6379
REDIS_CLUSTER_ADDRS=
REDIS_PASSWORD=
REDIS_TLS=false

# ---------- 应用配置 ----------
# JWT 密钥（生产必须修改为高强度随机串）
JWT_SECRET=

# 公共访问基础 URL（用于 CAS 回调等）
PUBLIC_BASE_URL=http://localhost
